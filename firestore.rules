rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myProfile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function myRole() { return signedIn() ? myProfile().data.role : null; }
    function isAdmin() { return myRole() == 'ADMIN'; }

    // Workspace-wide settings (auth config, notification config, restrictions)
    match /settings/{settingId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // User profiles: everyone signed in can see the directory (needed to
    // render names/roles in the UI); only the admin can create/edit/remove.
    // Exception: anyone can update their own `lastActiveAt` heartbeat,
    // `presenceStatus`/`statusText`, and `internStatus` — otherwise this collection is admin-only.
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isAdmin();
      allow update: if isAdmin() || (signedIn() && request.auth.uid == userId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActiveAt', 'presenceStatus', 'statusText', 'internStatus']));
      allow delete: if isAdmin();
    }

    // Activity logs: stores hourly activity signals for the heartbeat dashboard.
    // Users write their own logs, everyone can read, admins can delete.
    match /activity-logs/{logId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.id == request.auth.uid;
      allow delete: if isAdmin();
      
      match /screenshots/{screenshotId} {
        allow read: if signedIn();
        allow create, update: if signedIn() && logId == request.auth.uid;
        allow delete: if isAdmin();
      }
    }

    // Groups: readable by anyone signed in, only the admin can manage them.
    match /groups/{groupId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Access requests: admins create and resolve them.
    match /requests/{requestId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // File metadata: everyone signed in can read (folder-level filtering
    // happens in the UI); only non-clients can create/delete.
    match /files/{fileId} {
      allow read: if signedIn();
      allow create, delete: if signedIn() && myRole() != 'CLIENT';
      allow update: if isAdmin();
    }

    // People directory: internal staff records, not visible to clients.
    // Only admins can add, edit, or remove entries.
    match /people/{personId} {
      allow read: if signedIn() && myRole() != 'CLIENT';
      allow write: if isAdmin();
    }

    // Time-tracking entries (clock in/out sessions). Everyone manages their
    // own; only the admin can read or edit anyone else's. Clients never use
    // this feature at all, enforced both here and in the UI.
    match /time-entries/{entryId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn() && myRole() != 'CLIENT' && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // EOD Reports: Employees create and read their own. Admins can read, update, delete all.
    match /eod-reports/{reportId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn() && myRole() != 'CLIENT' && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Calendar events: Admins have full access.
    // Employees can read if type == 'company' or if they are attendees/organizer.
    // Employees can create/update their own individual events, but only admins can create company events.
    match /calendar-events/{eventId} {
      allow read: if signedIn() && (
        isAdmin() || 
        resource.data.type == 'company' || 
        request.auth.uid in resource.data.attendees || 
        resource.data.organizerId == request.auth.uid
      );
      allow create: if signedIn() && (
        isAdmin() || 
        (request.resource.data.type != 'company' && request.resource.data.organizerId == request.auth.uid)
      );
      allow update: if signedIn() && (
        isAdmin() || 
        (resource.data.organizerId == request.auth.uid && request.resource.data.type != 'company' && resource.data.type != 'company')
      );
      allow delete: if signedIn() && (
        isAdmin() || 
        (resource.data.organizerId == request.auth.uid && resource.data.type != 'company')
      );
    }

    // Leave requests: an Employee files one for themselves. The Admin approval chain is enforced.
    match /leave-requests/{requestId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn() && myRole() != 'CLIENT' && myRole() != 'ADMIN' && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Communication: internal team chat + 1:1 video calls. Clients never
    // see this feature (enforced in the UI); the rules below additionally
    // block them from creating a conversation/call even if they tried.

    // Conversations: only participants can read or write.
    match /conversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn() && myRole() != 'CLIENT' && request.auth.uid in request.resource.data.participantIds;
      allow update: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow delete: if signedIn() && request.auth.uid in resource.data.participantIds;

      match /messages/{messageId} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds && request.resource.data.senderId == request.auth.uid;
        allow update: if signedIn() && request.auth.uid == resource.data.senderId && request.resource.data.senderId == resource.data.senderId;
        allow delete: if signedIn() && (request.auth.uid == resource.data.senderId || isAdmin());
      }
    }

    // Calls: only the caller and callee can read/write the call doc and its subcollections.
    match /calls/{callId} {
      allow read: if signedIn() && (request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.calleeId);
      allow create: if signedIn() && myRole() != 'CLIENT' && request.auth.uid == request.resource.data.callerId;
      allow update: if signedIn() && (request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.calleeId);
      allow delete: if isAdmin();

      match /{subcollection}/{candidateId} {
        allow read, create: if signedIn() && (request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerId || request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.calleeId);
      }
    }
  }
}
